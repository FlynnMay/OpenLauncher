{
  "id": "system",
  "name": "System",
  "version": "1",
  "author": "OpenLauncher",
  "source": "https://github.com/FlynnMay/OpenLauncher",
  "categories": {
    "input": "Inputs",
    "app": "Apps",
    "launcher": "Launcher"
  },
  "settings": {
    "place": {
      "label": "Weather place",
      "type": "choice",
      "required": true,
      "from": {
        "url": "https://geocoding-api.open-meteo.com/v1/search?name={{query}}&count=6&format=json",
        "rows": "results",
        "label": "{{row.name}}{{row.admin1 ? ', ' + row.admin1 : ''}}{{row.country ? ', ' + row.country : ''}}",
        "keep": {
          "latitude": "{{row.latitude}}",
          "longitude": "{{row.longitude}}"
        },
        "on": "type",
        "minChars": 2
      }
    },
    "unit": {
      "label": "Temperature",
      "type": "choice",
      "as": "segmented",
      "options": {
        "celsius": "Celsius",
        "fahrenheit": "Fahrenheit"
      }
    }
  }
}
