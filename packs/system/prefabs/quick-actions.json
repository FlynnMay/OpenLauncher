{
  "id": "quick-actions",
  "name": "Quick actions",
  "root": {
    "id": "root",
    "name": "{{source.label}}",
    "modules": {
      "layout": {
        "mode": "column",
        "gap": 10
      },
      "dock": {
        "position": "center",
        "width": 432,
        "opening": "instant",
        "closeOnPress": true
      },
      "overlay": {
        "dim": 54,
        "modal": true
      },
      "variables": {
        "source": {
          "value": null,
          "type": "entity"
        }
      },
      "style": {
        "background": "#1a1c23fa",
        "radius": 18,
        "padding": 28,
        "clip": true
      }
    },
    "children": [
      {
        "id": "heading",
        "modules": {
          "text": {
            "text": "{{source.label}}",
            "overflow": "ellipsis"
          },
          "style": {
            "fontSize": 16,
            "fontWeight": "medium",
            "color": "#ffffffb3",
            "textAlign": "left"
          }
        }
      },
      {
        "id": "list",
        "modules": {
          "layout": {
            "mode": "flow",
            "columns": 1,
            "rowHeight": 40,
            "spacing": 4
          },
          "scroll": {
            "down": true
          },
          "sizing": {
            "flex": 1
          }
        },
        "children": [
          {
            "id": "open",
            "prefab": "button",
            "modules": {
              "variables": {
                "label": "Open",
                "icon": "material:play_arrow"
              },
              "triggers": {
                "press": [
                  {
                    "do": "open",
                    "entity": "{{source.id}}"
                  }
                ]
              }
            }
          },
          {
            "id": "info",
            "prefab": "button",
            "modules": {
              "variables": {
                "label": "App info",
                "icon": "material:info"
              },
              "triggers": {
                "press": [
                  {
                    "do": "info",
                    "entity": "{{source.id}}"
                  }
                ]
              }
            }
          },
          {
            "id": "uninstall",
            "prefab": "button",
            "modules": {
              "variables": {
                "label": "Uninstall",
                "icon": "material:delete"
              },
              "triggers": {
                "press": [
                  {
                    "do": "uninstall",
                    "entity": "{{source.id}}"
                  }
                ]
              }
            }
          },
          {
            "id": "remove",
            "prefab": "button",
            "modules": {
              "variables": {
                "label": "Remove",
                "icon": "material:do_not_disturb_on"
              },
              "triggers": {
                "press": [
                  {
                    "run": "launcher://layout/remove",
                    "with": {
                      "layer": "home",
                      "what": "{{source.id}}"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
