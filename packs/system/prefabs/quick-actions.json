{
  "id": "quick-actions",
  "name": "Quick actions",
  "root": {
    "id": "root",
    "name": "{{source.label}}",
    "modules": {
      "layout": {
        "mode": "flow",
        "columns": 1,
        "rowHeight": 40,
        "spacing": 4
      },
      "dock": {
        "position": "center",
        "width": 432,
        "opening": "instant",
        "closeOnPress": true
      },
      "scroll": {
        "down": true
      },
      "style": {
        "background": "#1a1c23fa",
        "radius": 18,
        "padding": 28
      },
      "variables": {
        "source": {
          "value": null,
          "type": "entity"
        }
      },
      "triggers": {
        "reveal": [
          {
            "run": "launcher://layers/new",
            "with": {
              "dim": 0.54,
              "modal": true
            }
          },
          {
            "run": "launcher://layers/raise"
          }
        ],
        "hide": [
          {
            "run": "launcher://layers/close"
          }
        ]
      }
    },
    "children": [
      {
        "id": "open",
        "prefab": "button",
        "modules": {
          "variables": {
            "label": "Open",
            "icon": "material:play_arrow"
          },
          "triggers": {
            "press": [
              {
                "do": "open",
                "entity": "{{source.id}}"
              }
            ]
          }
        }
      },
      {
        "id": "info",
        "prefab": "button",
        "modules": {
          "variables": {
            "label": "App info",
            "icon": "material:info"
          },
          "triggers": {
            "press": [
              {
                "do": "info",
                "entity": "{{source.id}}"
              }
            ]
          }
        }
      },
      {
        "id": "uninstall",
        "prefab": "button",
        "modules": {
          "variables": {
            "label": "Uninstall",
            "icon": "material:delete"
          },
          "triggers": {
            "press": [
              {
                "do": "uninstall",
                "entity": "{{source.id}}"
              }
            ]
          }
        }
      },
      {
        "id": "remove",
        "prefab": "button",
        "modules": {
          "variables": {
            "label": "Remove",
            "icon": "material:do_not_disturb_on"
          },
          "triggers": {
            "press": [
              {
                "run": "launcher://layout/remove",
                "with": {
                  "layer": "home",
                  "what": "{{source.id}}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
