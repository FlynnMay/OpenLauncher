{
  "id": "now-playing",
  "name": "Now playing",
  "root": {
    "id": "root",
    "modules": {
      "visibility": {
        "visible": "{{source.title}}"
      },
      "layout": {
        "mode": "row",
        "gap": 12
      },
      "variables": {
        "source": {
          "value": "media",
          "type": "entity"
        },
        "stateIcon": {
          "when": "{{source.playing}}",
          "cases": [
            {
              "equals": "true",
              "then": "material:pause_circle"
            }
          ],
          "else": "material:play_arrow",
          "exposed": false
        },
        "summary": {
          "when": "{{source.artist}}",
          "cases": [
            {
              "equals": "",
              "then": "{{source.app}}"
            }
          ],
          "else": "{{source.artist}} · {{source.app}}",
          "exposed": false
        }
      },
      "triggers": {
        "press": [
          {
            "do": "playPause",
            "entity": "{{source.id}}"
          }
        ]
      },
      "sizing": {
        "w": 2
      },
      "style": {
        "padding": 8
      },
      "focus": {
        "scale": 104
      }
    },
    "children": [
      {
        "id": "cover",
        "modules": {
          "picture": {
            "source": "{{source.art}}"
          },
          "sizing": {
            "aspect": 1.0
          }
        }
      },
      {
        "id": "lines",
        "modules": {
          "layout": {
            "mode": "column",
            "align": "start"
          },
          "sizing": {
            "flex": 1
          }
        },
        "children": [
          {
            "id": "title",
            "modules": {
              "text": {
                "text": "{{source.title | default:Nothing is playing}}"
              },
              "style": {
                "fontSize": 15,
                "fontWeight": "medium"
              }
            }
          },
          {
            "id": "summary",
            "modules": {
              "text": {
                "text": "{{summary}}"
              },
              "style": {
                "fontSize": 13,
                "color": "#ffffffb3"
              }
            }
          }
        ]
      },
      {
        "id": "state",
        "modules": {
          "icon": {
            "icon": "{{stateIcon}}",
            "size": 24
          }
        }
      }
    ]
  },
  "variants": {
    "row": {
      "label": "Beside its cover"
    }
  }
}
