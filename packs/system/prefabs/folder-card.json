{
  "id": "folder-card",
  "name": "Folder card",
  "root": {
    "id": "root",
    "modules": {
      "layout": {
        "mode": "column",
        "gap": 6
      },
      "variables": {
        "source": {
          "value": null,
          "type": "entity"
        }
      },
      "triggers": {
        "press": [
          {
            "run": "launcher://variables/set",
            "with": {
              "var": "open",
              "value": true,
              "of": "{{source.id}}"
            }
          }
        ]
      },
      "focus": {
        "target": "picture",
        "bare": "{{source.bare}}",
        "scale": 108
      }
    },
    "children": [
      {
        "id": "picture",
        "modules": {
          "preview": {
            "node": "{{source.id}}"
          },
          "sizing": {
            "flex": 1
          }
        }
      },
      {
        "id": "name",
        "modules": {
          "text": {
            "text": "{{source.label}}",
            "overflow": "ellipsis"
          },
          "style": {
            "fontSize": 12,
            "fontWeight": "medium"
          },
          "sizing": {
            "keep": true
          }
        }
      }
    ]
  },
  "variants": {
    "stacked": {
      "label": "Name under the picture"
    },
    "row": {
      "label": "Name beside the picture",
      "overrides": {
        "root": {
          "modules": {
            "layout": {
              "mode": "row",
              "gap": 12
            },
            "focus": {
              "scale": 104
            }
          }
        },
        "picture": {
          "modules": {
            "sizing": {
              "flex": 0,
              "aspect": 1.7777777777777777
            }
          }
        },
        "name": {
          "modules": {
            "style": {
              "textAlign": "left"
            },
            "sizing": {
              "flex": 1,
              "keep": false
            }
          }
        }
      }
    }
  }
}
