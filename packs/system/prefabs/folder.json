{
  "id": "folder",
  "name": "Folder",
  "template": true,
  "card": "folder-card",
  "root": {
    "id": "root",
    "kind": "pane",
    "options": {
      "title": "Folder",
      "mode": "flow",
      "columns": 4,
      "dock": "center",
      "opening": "instant"
    },
    "style": {
      "background": "#1a1c23fa",
      "radius": 18,
      "padding": 28
    },
    "on": {
      "reveal": [
        {
          "run": "launcher://layers/new",
          "with": {
            "dim": 0.54,
            "modal": true
          }
        },
        {
          "run": "launcher://layers/raise"
        }
      ],
      "hide": [
        {
          "run": "launcher://layers/close"
        }
      ]
    }
  }
}
