{
  "id": "clock",
  "name": "Clock",
  "root": {
    "id": "root",
    "modules": {
      "layout": {
        "mode": "column",
        "fit": true,
        "align": "center"
      },
      "variables": {
        "source": {
          "value": "clock",
          "type": "entity"
        }
      },
      "sizing": {
        "w": 2
      }
    },
    "children": [
      {
        "id": "time",
        "modules": {
          "text": {
            "text": "{{source.time}}"
          },
          "style": {
            "fontSize": 44
          }
        }
      },
      {
        "id": "date",
        "modules": {
          "text": {
            "text": "{{source.date}}"
          },
          "style": {
            "fontSize": 14,
            "color": "#ffffffb3"
          }
        }
      }
    ]
  },
  "variants": {
    "stacked": {
      "label": "Date under the time"
    }
  }
}
