{
  "id": "clock",
  "name": "Clock",
  "root": {
    "id": "root",
    "kind": "pane",
    "transform": {
      "w": 2
    },
    "options": {
      "mode": "column",
      "fit": true,
      "align": "center"
    },
    "vars": {
      "source": {
        "value": "clock",
        "type": "entity"
      }
    },
    "children": [
      {
        "id": "time",
        "kind": "text",
        "options": {
          "text": "{{source.time}}"
        },
        "style": {
          "fontSize": 44
        }
      },
      {
        "id": "date",
        "kind": "text",
        "options": {
          "text": "{{source.date}}"
        },
        "style": {
          "fontSize": 14,
          "color": "#ffffffb3"
        }
      }
    ]
  },
  "variants": {
    "stacked": {
      "label": "Date under the time"
    }
  }
}
