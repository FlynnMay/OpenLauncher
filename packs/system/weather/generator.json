{
  "$schema": "https://raw.githubusercontent.com/FlynnMay/OpenLauncher/main/schemas/generator.schema.json",
  "from": "weather",
  "tables": {
    "sky": {
      "0": "clear",
      "1": "clear",
      "2": "partlyCloudy",
      "3": "cloudy",
      "45": "fog",
      "48": "fog",
      "51": "rain",
      "53": "rain",
      "55": "rain",
      "56": "rain",
      "57": "rain",
      "61": "rain",
      "63": "rain",
      "65": "rain",
      "66": "rain",
      "67": "rain",
      "71": "snow",
      "73": "snow",
      "75": "snow",
      "77": "snow",
      "80": "rain",
      "81": "rain",
      "82": "rain",
      "85": "snow",
      "86": "snow",
      "95": "storm",
      "96": "storm",
      "99": "storm"
    },
    "description": {
      "0": "Clear",
      "1": "Mostly clear",
      "2": "Partly cloudy",
      "3": "Cloudy",
      "45": "Fog",
      "48": "Fog",
      "51": "Drizzle",
      "53": "Drizzle",
      "55": "Drizzle",
      "56": "Drizzle",
      "57": "Drizzle",
      "61": "Rain",
      "63": "Rain",
      "65": "Rain",
      "66": "Rain",
      "67": "Rain",
      "71": "Snow",
      "73": "Snow",
      "75": "Snow",
      "77": "Snow",
      "80": "Showers",
      "81": "Showers",
      "82": "Showers",
      "85": "Snow showers",
      "86": "Snow showers",
      "95": "Thunderstorm",
      "96": "Thunderstorm",
      "99": "Thunderstorm"
    }
  },
  "entity": {
    "id": "weather",
    "category": "weather",
    "label": "Weather",
    "data": {
      "text": "{{round(row.current.temperature_2m)}}°",
      "temperature": "{{row.current.temperature_2m}}",
      "high": "{{row.daily.temperature_2m_max[0]}}",
      "low": "{{row.daily.temperature_2m_min[0]}}",
      "description": "{{get(tables.description, row.current.weather_code)}}",
      "sky": "{{get(tables.sky, row.current.weather_code) ?? 'rain'}}",
      "location": "{{location.name}}"
    }
  }
}
