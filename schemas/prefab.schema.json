{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FlynnMay/OpenLauncher/main/schemas/prefab.schema.json",
  "title": "Pack prefab file",
  "$defs": {
    "one": {
      "type": "object",
      "description": "A saved node, reused through instances.",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Where this file is checked."
        },
        "$comment": {
          "type": "string",
          "description": "A note for readers."
        },
        "$defs": {
          "type": "object",
          "description": "Chunks the objects inside this one can reuse with $use."
        },
        "$use": {
          "type": "string",
          "description": "The name of a chunk to put here; keys beside it win."
        },
        "params": {
          "type": "object",
          "description": "What the chunk named by $use takes."
        },
        "id": {
          "type": "string",
          "description": "A name without \":\"; the pack adds its own."
        },
        "name": {
          "type": "string"
        },
        "card": {
          "type": "string",
          "description": "The prefab an instance of this opens."
        },
        "root": {
          "$ref": "common.schema.json#/$defs/node"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "$schema": {
                "type": "string",
                "description": "Where this file is checked."
              },
              "$comment": {
                "type": "string",
                "description": "A note for readers."
              },
              "$defs": {
                "type": "object",
                "description": "Chunks the objects inside this one can reuse with $use."
              },
              "$use": {
                "type": "string",
                "description": "The name of a chunk to put here; keys beside it win."
              },
              "params": {
                "type": "object",
                "description": "What the chunk named by $use takes."
              },
              "label": {
                "type": "string"
              },
              "overrides": {
                "$ref": "common.schema.json#/$defs/overrides"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "not": {
          "required": [
            "$use"
          ]
        }
      },
      "then": {
        "required": [
          "id",
          "root"
        ]
      }
    }
  },
  "type": "object",
  "if": {
    "anyOf": [
      {
        "required": [
          "id"
        ]
      },
      {
        "required": [
          "$use"
        ]
      }
    ]
  },
  "then": {
    "$ref": "#/$defs/one"
  },
  "else": {
    "properties": {
      "$schema": {
        "type": "string"
      },
      "$comment": {
        "type": "string"
      },
      "$defs": {
        "type": "object"
      }
    },
    "additionalProperties": {
      "$ref": "#/$defs/one"
    }
  }
}
